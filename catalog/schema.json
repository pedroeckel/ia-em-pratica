{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "type",
      "title",
      "summary",
      "outcome",
      "provider",
      "ownership",
      "url",
      "license",
      "skillPath",
      "level",
      "goals",
      "clients",
      "compatibility",
      "validation",
      "setup",
      "prompt",
      "tags"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "outcome": {
        "type": "string",
        "minLength": 1
      },
      "provider": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "minLength": 1,
        "pattern": "^https://"
      },
      "license": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "skill",
          "mcp",
          "plugin"
        ]
      },
      "ownership": {
        "enum": [
          "autoral",
          "terceiro"
        ]
      },
      "skillPath": {
        "type": [
          "string",
          "null"
        ]
      },
      "level": {
        "enum": [
          "iniciante",
          "intermediario",
          "avancado"
        ]
      },
      "goals": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "planejamento",
            "desenvolvimento",
            "pesquisa",
            "integracoes"
          ]
        }
      },
      "clients": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "codex",
            "claude-code"
          ]
        }
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "prompt": {
        "type": [
          "string",
          "null"
        ]
      },
      "compatibility": {
        "type": "object",
        "required": [
          "codex",
          "claude-code"
        ],
        "additionalProperties": false,
        "properties": {
          "codex": {
            "type": "string",
            "minLength": 1
          },
          "claude-code": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "validation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "date",
          "version",
          "environment",
          "scope",
          "limitations",
          "evidence",
          "reviewAfterDays",
          "contentSha256"
        ],
        "properties": {
          "status": {
            "enum": [
              "testado",
              "em-avaliacao",
              "descontinuado"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewAfterDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "contentSha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "setup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirements",
          "steps",
          "verify",
          "uninstall"
        ],
        "properties": {
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "code"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "verify": {
            "type": "string",
            "minLength": 1
          },
          "uninstall": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
